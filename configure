	function PORTAGE_GIT_MIRROR_help()  { echo "Endpoint git usado para sincronizar a árvore do Portage. Normalmente não precisa ser alterado. Mude apenas se o mirror padrão estiver lento ou inacessível na sua região."; }

	function GENTOO_MIRROR_tag()  { echo "Mirror de download do Gentoo"; }
	function GENTOO_MIRROR_help() { echo "URL do servidor de onde o stage3 e os pacotes binários serão baixados. Selecione o mais próximo de você para maior velocidade. O mirror detectado automaticamente já é o ideal para sua região."; }

	function GENTOO_ARCH_tag()    { echo "Arquitetura alvo"; }
	function GENTOO_ARCH_help()    { echo "Tag de arquitetura do Gentoo para o novo sistema. Para a maioria dos PCs modernos: amd64 (64-bit). Não altere a menos que esteja instalando em ARM ou x86 32-bit."; }

	function GENTOO_SUBARCH_tag() { echo "Sub-arquitetura (subarch)"; }
	function GENTOO_SUBARCH_help() { echo "Sub-arquitetura do Gentoo para o novo sistema. Deixe vazio para usar o padrão genérico. Usado principalmente para arquiteturas especiais (ARM, MIPS, RISC-V)."; }

	function USE_PORTAGE_TESTING_tag()  { echo "Aceitar pacotes de teste (~amd64)"; }
	function USE_PORTAGE_TESTING_help() { echo "Permite instalar pacotes marcados como 'testing' (~amd64). Dá acesso a versões mais recentes de software. Recomendado para hardware moderno e para o Hyprland, que evolui rapidamente."; }

	function SELECT_MIRRORS_tag()           { echo "Selecionar mirrors automaticamente (mirrorselect)"; }
	function SELECT_MIRRORS_help()          { echo "Usa a ferramenta 'mirrorselect' para fazer benchmark e encontrar os mirrors de download mais rápidos para sua localização. Pode demorar 1-2 minutos mas melhora significativamente a velocidade de download."; }

