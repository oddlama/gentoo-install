{
    "name": "finance-app/financial-management-system",
    "description": "Production-grade personal financial and gig income management system",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.3",
        "ext-pdo": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "ext-gd": "*",
        "ext-zip": "*",
        "phpmailer/phpmailer": "^6.9",
        "spomky-labs/otphp": "^11.3",
        "endroid/qr-code": "^5.0",
        "tecnickcom/tcpdf": "^6.7",
        "phpoffice/phpspreadsheet": "^2.0",
        "league/csv": "^9.15",
        "symfony/dotenv": "^7.0",
        "vlucas/phpdotenv": "^5.6",
        "monolog/monolog": "^3.5"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/",
            "App\\Core\\": "src/Core/",
            "App\\Controllers\\": "src/Controllers/",
            "App\\Models\\": "src/Models/",
            "App\\Services\\": "src/Services/",
            "App\\Repositories\\": "src/Repositories/",
            "App\\Middleware\\": "src/Middleware/",
            "App\\Exceptions\\": "src/Exceptions/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
