# Application Configuration
APP_NAME="Financial Management System"
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost
APP_TIMEZONE=America/New_York

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=finance_db
DB_USER=finance_user
DB_PASS=
DB_CHARSET=utf8mb4

# Security Configuration
APP_KEY=
SESSION_LIFETIME=7200
SESSION_SECURE=true
SESSION_HTTPONLY=true
SESSION_SAMESITE=strict

# CSRF Protection
CSRF_TOKEN_NAME=csrf_token
CSRF_TOKEN_LIFETIME=3600

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_REQUESTS=60
RATE_LIMIT_WINDOW=60

# Two-Factor Authentication
2FA_ENABLED=true
2FA_ISSUER="Financial Management System"

# Email Configuration (SMTP)
MAIL_ENABLED=false
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME="Financial Management System"

# File Upload Configuration
UPLOAD_MAX_SIZE=10485760
UPLOAD_ALLOWED_TYPES=pdf,jpg,jpeg,png,doc,docx,xls,xlsx
UPLOAD_ENCRYPT=true

# Tax Configuration
TAX_FEDERAL_RATE=0.22
TAX_STATE_RATE=0.05
TAX_SELF_EMPLOYMENT_RATE=0.153
TAX_YEAR=2024
IRS_MILEAGE_RATE=0.67

# Backup Configuration
BACKUP_ENABLED=true
BACKUP_ENCRYPT=true
BACKUP_RETENTION_DAYS=30

# Logging Configuration
LOG_LEVEL=warning
LOG_PATH=storage/logs/app.log
AUDIT_LOG_ENABLED=true

# Security Headers
SECURITY_HSTS_ENABLED=true
SECURITY_CSP_ENABLED=true
SECURITY_FRAME_OPTIONS=DENY
SECURITY_XSS_PROTECTION=1

# IP Whitelisting (optional, comma-separated)
IP_WHITELIST=

# Failed Login Protection
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_DURATION=900

# Password Policy
PASSWORD_MIN_LENGTH=12
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_NUMBERS=true
PASSWORD_REQUIRE_SPECIAL=true
PASSWORD_ROTATION_DAYS=90
